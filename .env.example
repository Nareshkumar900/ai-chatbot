# AI Medical Doctor-Patient Management System Configuration

PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=super_secret_medical_jwt_key_2026_aiml_secure_token
JWT_EXPIRES_IN=7d

# Database Configuration ('sqlite' or 'mysql')
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medical_system_db

# Medical Certificate Expiration Warning (in days)
CERTIFICATE_REVIEW_THRESHOLD_DAYS=30

# AI Medical Chatbot & Intelligence API Key (Claude AI by Anthropic)
# Leave blank to use the high-fidelity built-in Medical Knowledge & Clinical Safety engine
CLAUDE_API_KEY=your_claude_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# MATLAB Deep Learning Microservice URL (Default port 6000)
MATLAB_SERVICE_URL=http://127.0.0.1:6000/predict
